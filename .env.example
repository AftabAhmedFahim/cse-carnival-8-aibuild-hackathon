# Copy this file to .env and fill in your values.
# Never commit your actual .env file.

# ---------------------------------------------------------------------------
# LLM API key — the agent (Person C) reads exactly one of these.
# Set the one matching the provider configured in lib/agent/.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# GOOGLE_API_KEY=your_key_here
# GROQ_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# No DATABASE_URL is needed. prisma/schema.prisma hardcodes the SQLite path
# ("file:./dev.db") on purpose, so a fresh clone runs with zero env setup:
#
#   npm install && npx prisma migrate dev --name init && npm run seed && npm run dev
#
# If we ever move off SQLite, switch the datasource back to env("DATABASE_URL")
# and add it here.
